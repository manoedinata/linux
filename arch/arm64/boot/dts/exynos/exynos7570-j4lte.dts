/dts-v1/;
#include "exynos7570.dtsi"

/ {
	model = "Samsung Galaxy J4";
	compatible = "samsung,j4lte", "samsung,exynos7570";
	chassis-type = "handset";

	chosen {
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		bootargs = "console=tty0 ignore_loglevel clk_ignore_unused regulator_ignore_unused j4.autoreboot=45";

		/* Set up by the bootloader (uniLoader), scanned out by DECON */
		framebuffer0: framebuffer@67000000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0x67000000 (720 * 1280 * 4)>;
			width = <720>;
			height = <1280>;
			stride = <(720 * 4)>;
			format = "a8r8g8b8";
		};
	};

	/*
	 * Supply of the USB PHY. It comes from the PMIC and is left on by the
	 * bootloader; there is no PMIC driver yet, so describe it as always on.
	 */
	vdd_usb33: regulator-usb33 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_usb33";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x3e800000>,
		      <0x0 0x80000000 0x40000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		/*
		 * Survives a warm reset. S-BOOT clears 0x7e280000-0x7e2fffff at
		 * every boot, so the zones (and their ECC parity at the zone
		 * ends) have to stay below it.
		 */
		ramoops@7e100000 {
			compatible = "ramoops";
			reg = <0x0 0x7e100000 0x180000>;
			record-size = <0x20000>;
			console-size = <0x100000>;
			pmsg-size = <0x20000>;
			ecc-size = <16>;
			no-map;
		};

		bootloader-scratch@7e280000 {
			reg = <0x0 0x7e280000 0x80000>;
			no-map;
		};

		framebuffer@67000000 {
			reg = <0x0 0x67000000 (720 * 1280 * 4)>;
			no-map;
		};

		tima@52800000 {
			reg = <0x0 0x52800000 0x200000>;
			no-map;
		};

		camera@710ef000 {
			reg = <0x0 0x710ef000 0x1000>;
			no-map;
		};

		video-fw@710f0000 {
			reg = <0x0 0x710f0000 0x110000>;
			no-map;
		};

		video-stream@72200000 {
			reg = <0x0 0x72200000 0x1200000>;
			no-map;
		};

		modem@73400000 {
			reg = <0x0 0x73400000 0x5c00000>;
			no-map;
		};

		wifibt@79000000 {
			reg = <0x0 0x79000000 0x400000>;
			no-map;
		};
	};
};

&mmc0 {
	/* Pins are left as S-BOOT set them up */
	vmmc-supply = <&ldo14_reg>;
	vqmmc-supply = <&ldo15_reg>;

	bus-width = <8>;
	fifo-depth = <64>;
	samsung,dw-mshc-ciu-div = <3>;
	samsung,dw-mshc-sdr-timing = <0 2>;
	samsung,dw-mshc-ddr-timing = <2 4>;
	non-removable;
	cap-mmc-highspeed;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	no-sd;
	no-sdio;

	status = "okay";
};

&usbdrd {
	vdd33-supply = <&vdd_usb33>;

	status = "okay";
};

&usbdrd_dwc3 {
	dr_mode = "peripheral";
};

&speedy {
	status = "okay";

	pmic@0 {
		compatible = "samsung,s2mpu06-pmic";
		reg = <0x0>;

		interrupt-parent = <&gpa0>;
		interrupts = <5 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&pmic_irq>;

		regulators {
			buck1_reg: BUCK1 {
				regulator-name = "BUCK1";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-ramp-delay = <12000>;
			};

			buck2_reg: BUCK2 {
				regulator-name = "BUCK2";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <2800000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-ramp-delay = <12000>;
			};

			buck3_reg: BUCK3 {
				regulator-name = "BUCK3";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <2800000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-ramp-delay = <12000>;
			};

			ldo1_reg: LDO1 {
				regulator-name = "vdd_ldo1";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-ramp-delay = <12000>;
			};

			ldo2_reg: LDO2 {
				regulator-name = "vdd_ldo2";
				regulator-min-microvolt = <1500000>;
				regulator-max-microvolt = <2000000>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <12000>;
			};

			ldo3_reg: LDO3 {
				regulator-name = "vdd_ldo3";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1500000>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <12000>;
			};

			ldo4_reg: LDO4 {
				regulator-name = "vqmmc";
				regulator-min-microvolt = <1700000>;
				regulator-max-microvolt = <3350000>;
				regulator-ramp-delay = <12000>;
			};

			ldo5_reg: LDO5 {
				regulator-name = "vdd_ldo5";
				regulator-min-microvolt = <1700000>;
				regulator-max-microvolt = <3350000>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <12000>;
			};

			ldo6_reg: LDO6 {
				regulator-name = "vdd_ldo6";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1300000>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <12000>;
			};

			ldo7_reg: LDO7 {
				regulator-name = "vdd_ldo7";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1300000>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <12000>;
			};

			ldo8_reg: LDO8 {
				regulator-name = "vdd_ldo8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3375000>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <12000>;
			};

			ldo13_reg: LDO13 {
				regulator-name = "vdd_ldo13";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <2000000>;
				regulator-ramp-delay = <12000>;
				regulator-always-on;
				regulator-boot-on;
			};

			ldo14_reg: LDO14 {
				regulator-name = "vemmc";
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3300000>;
				regulator-ramp-delay = <12000>;
			};

			ldo15_reg: LDO15 {
				regulator-name = "vqemmc";
				regulator-min-microvolt = <1700000>;
				regulator-max-microvolt = <1950000>;
				regulator-ramp-delay = <12000>;
			};

			ldo16_reg: LDO16 {
				regulator-name = "VDD_MOTOR_3P3";
				regulator-min-microvolt = <3100000>;
				regulator-max-microvolt = <3100000>;
				regulator-ramp-delay = <12000>;
			};

			ldo17_reg: LDO17 {
				regulator-name = "VDD18_CAM_SENSOR_IO";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-ramp-delay = <12000>;
			};

			ldo18_reg: LDO18 {
				regulator-name = "VDD28_CAM_AF";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
				regulator-ramp-delay = <12000>;
			};

			ldo19_reg: LDO19 {
				regulator-name = "vtouch_2.2v";
				regulator-min-microvolt = <2200000>;
				regulator-max-microvolt = <2200000>;
				regulator-boot-on;
			};

			ldo20_reg: LDO20 {
				regulator-name = "LCD_1P8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
			};

			ldo21_reg: LDO21 {
				regulator-name = "vdd_ldo21";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3375000>;
				regulator-ramp-delay = <12000>;
			};

			ldo22_reg: LDO22 {
				regulator-name = "vdd_ldo22";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3375000>;
				regulator-always-on;
				regulator-ramp-delay = <12000>;
			};

			ldo23_reg: LDO23 {
				regulator-name = "VDD23_CAM_CORE_1P2";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				regulator-ramp-delay = <12000>;
			};

			ldo24_reg: LDO24 {
				regulator-name = "AVDD24_CAM_2P8";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
				regulator-ramp-delay = <12000>;
			};
		};
	};
};
