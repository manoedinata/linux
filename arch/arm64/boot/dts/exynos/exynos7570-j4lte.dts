/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include "exynos7570.dtsi"

/ {
	model = "Samsung Galaxy J4";
	compatible = "samsung,j4lte", "samsung,exynos7570";
	chassis-type = "handset";

	chosen {
		bootargs = "console=tty0 ignore_loglevel clk_ignore_unused regulator_ignore_unused root=/dev/mmcblk0p18 rootfstype=ext4";
	};

	/*
	 * Supply of the USB PHY. It comes from the PMIC and is left on by the
	 * bootloader; there is no PMIC driver yet, so describe it as always on.
	 */
	vdd_usb33: regulator-usb33 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_usb33";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x3e800000>,
		      <0x0 0x80000000 0x40000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		/*
		 * Survives a warm reset. S-BOOT clears 0x7e280000-0x7e2fffff at
		 * every boot, so the zones (and their ECC parity at the zone
		 * ends) have to stay below it.
		 */
		ramoops@7e100000 {
			compatible = "ramoops";
			reg = <0x0 0x7e100000 0x180000>;
			record-size = <0x20000>;
			console-size = <0x100000>;
			pmsg-size = <0x20000>;
			ecc-size = <16>;
			no-map;
		};

		bootloader-scratch@7e280000 {
			reg = <0x0 0x7e280000 0x80000>;
			no-map;
		};

		/*
		 * Firmware memory the downstream DT keeps away from the kernel
		 * (/memreserve/ 0x7e700000 0x100000 in exynos7570-rmem.dtsi).
		 * Something outside Linux writes into it at run time: handed
		 * out as RAM, freed sk_buffs there got 64-byte blocks zeroed.
		 */
		firmware@7e700000 {
			reg = <0x0 0x7e700000 0x100000>;
			no-map;
		};

		framebuffer@67000000 {
			reg = <0x0 0x67000000 (720 * 1280 * 4)>;
			no-map;
		};

		tima@52800000 {
			reg = <0x0 0x52800000 0x200000>;
			no-map;
		};

		camera@710ef000 {
			reg = <0x0 0x710ef000 0x1000>;
			no-map;
		};

		video-fw@710f0000 {
			reg = <0x0 0x710f0000 0x110000>;
			no-map;
		};

		video-stream@72200000 {
			reg = <0x0 0x72200000 0x1200000>;
			no-map;
		};

		modem_rmem: modem@73400000 {
			reg = <0x0 0x73400000 0x5c00000>;
			no-map;
		};

		wlbt_rmem: wifibt@79000000 {
			reg = <0x0 0x79000000 0x400000>;
			no-map;
		};
	};
};

&{/} {
	battery: battery {
		compatible = "simple-battery";
		device-chemistry = "lithium-ion";
		voltage-max-design-microvolt = <4350000>;
		charge-full-design-microamp-hours = <3000000>;
	};
};

&mmc0 {
	/* Pins are left as S-BOOT set them up */
	vmmc-supply = <&ldo14_reg>;
	vqmmc-supply = <&ldo15_reg>;

	bus-width = <8>;
	fifo-depth = <64>;
	samsung,dw-mshc-ciu-div = <3>;
	samsung,dw-mshc-sdr-timing = <0 2>;
	samsung,dw-mshc-ddr-timing = <2 4>;
	samsung,hs400-ulp-mode;
	samsung,dw-mshc-hs400-timing = <0 3>;
	samsung,dw-mshc-txdt-crc-timer-fastlimit = <0x34>;
	samsung,dw-mshc-txdt-crc-timer-initval = <0x38>;
	samsung,read-strobe-delay = <0x60>;
	non-removable;
	cap-mmc-highspeed;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	/*
	 * HS400 works (see the ULP timing above) but is left off until the data
	 * corruption seen during large package installs is explained. It is
	 * suspected, not proven, to be involved.
	 */
	/* mmc-hs400-1_8v; */
	no-sd;
	no-sdio;

	status = "okay";
};

/* the USB PLL (usbpll,owner) is left to the AP for now */
&wlbt {
	memory-region = <&wlbt_rmem>;
	status = "okay";
};

&usbdrd {
	vdd33-supply = <&vdd_usb33>;

	status = "okay";
};

&usbdrd_dwc3 {
	dr_mode = "peripheral";
};

&speedy {
	status = "okay";

	pmic@0 {
		compatible = "samsung,s2mpu06-pmic";
		reg = <0x0>;

		interrupt-parent = <&gpa0>;
		interrupts = <5 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&pmic_irq>;

		monitored-battery = <&battery>;
		extcon = <&muic>;

		/* battery NTC on the AP's ADC channel 1 */
		io-channels = <&adc 1>;
		io-channel-names = "adc-temp";
		samsung,temp-adc-table = <311 358 417 483 566 659 772 842 912 957 994 1085 1150 1228 1361 1377 1456 1548 1581 1782 2026 2252 2477 2578 2712 2796 2937 3010 3126 3227 3302 3446 3574 3681>;
		samsung,temp-decidegc-table = <900 850 800 750 700 650 600 570 550 530 500 470 450 430 410 400 380 360 350 300 250 200 150 130 100 80 50 30 0 (-30) (-50) (-100) (-150) (-200)>;

		/* fuel gauge: percent scale in 0.1 % units, low-battery alert in percent */
		samsung,capacity-max = <1000>;
		samsung,capacity-max-margin = <150>;
		samsung,fuel-alert-soc = <1>;

		/* ageing steps: first cycle count, float voltage, gauge's 100 % voltage, cell data */
		samsung,age-cycles = <0 28 36>;
		samsung,age-float-microvolt = <4350000>, <4330000>, <4310000>;
		samsung,age-raw100-millivolt = <4309 4269 4255>;
		samsung,cell-character0 = /bits/ 8 <
			0xff 0x0a 0x79 0x0a 0xf3 0x09 0x7d 0x09 0x0d 0x09 0xa6 0x08
			0x35 0x08 0xd0 0x07 0x8f 0x07 0x38 0x07 0xd7 0x06 0x9c 0x06
			0x73 0x06 0x55 0x06 0x3b 0x06 0x32 0x06 0x17 0x06 0xdf 0x05
			0x8d 0x05 0x88 0x05 0xeb 0x02 0x02 0x02 0x6a 0x08 0x00 0x08
			0x95 0x07 0x2b 0x07 0xc0 0x06 0x56 0x06 0xeb 0x05 0x81 0x05
			0x16 0x05 0xac 0x04 0x41 0x04 0xd7 0x03 0x6c 0x03 0x02 0x03
			0x97 0x02 0x2d 0x02 0xc2 0x01 0x58 0x01 0xed 0x00 0x83 0x00
			0x18 0x00 0xf8 0x0f 0xfe 0x29 0xdc 0x29 0x8a 0x29 0x4d 0x29
			0x28 0x1f 0x23 0x10 0x21 0x21 0x14 0x21 0xf2 0xf7 0xe6 0xf7
			0xd3 0xde 0xca 0xd4 0xd3 0xd4 0x40 0x80 0x26 0x33 0x26 0x40
			0x26 0x5c 0x26 0x5c 0x26 0x5c 0xff 0xff 0x02 0x05 0x14 0x0b
			0x03 0x12 0x06 0x1c 0x0c 0x1c 0x10 0x1c 0x1f 0x1f 0x3c 0x3c
			0x3c 0x3c 0x3c 0x3c 0x3b 0x3c 0x3c 0x3c 0x3d 0x3d 0x3f 0x41
			0x42 0x46 0x4c 0x58 0x80 0xcd 0xff 0xff 0xa9 0x0a 0xa9 0x0a
			0x28 0x0a 0xa7 0x09 0x36 0x09 0xca 0x08 0x77 0x08 0xe9 0x07
			0xb1 0x07 0x67 0x07 0x00 0x07 0xb4 0x06 0x85 0x06 0x62 0x06
			0x45 0x06 0x37 0x06 0x2b 0x06 0x03 0x06 0xbf 0x05 0x85 0x05
			0x74 0x05 0xf0 0x03 0x6f 0x08 0x6f 0x08 0x00 0x08 0x91 0x07
			0x22 0x07 0xb3 0x06 0x44 0x06 0xd5 0x05 0x66 0x05 0xf7 0x04
			0x88 0x04 0x19 0x04 0xaa 0x03 0x3b 0x03 0xcc 0x02 0x5d 0x02
			0xee 0x01 0x7f 0x01 0x10 0x01 0xa2 0x00 0x33 0x00 0xda 0x0f
			0xfe 0x29 0xdc 0x29 0x8a 0x29 0x4d 0x29 0x28 0x1f 0x23 0x10
			0x21 0x21 0x14 0x21 0xf7 0xf7 0xe6 0xf7 0xd3 0xde 0xca 0xd4
			0xd3 0xd4 0x40 0x80 0x26 0x33 0x26 0x40 0x26 0x5c 0x26 0x5c
			0x26 0x5c 0xff 0xff 0x02 0x05 0x14 0x0b 0x03 0x12 0x06 0x1c
			0x0c 0x1c 0x10 0x1c 0x1f 0x1f 0x40 0x40 0x40 0x3f 0x3e 0x3f
			0x3f 0x40 0x40 0x3f 0x40 0x41 0x43 0x46 0x48 0x4b 0x54 0x60
			0x71 0x8b 0xb9 0xcd 0xa9 0x0a 0xa9 0x0a 0x28 0x0a 0xa7 0x09
			0x36 0x09 0xca 0x08 0x77 0x08 0xe9 0x07 0xb1 0x07 0x67 0x07
			0x00 0x07 0xb4 0x06 0x85 0x06 0x62 0x06 0x45 0x06 0x37 0x06
			0x2b 0x06 0x03 0x06 0xbf 0x05 0x85 0x05 0x74 0x05 0xf0 0x03
			0x89 0x08 0x89 0x08 0x19 0x08 0xa9 0x07 0x38 0x07 0xc8 0x06
			0x58 0x06 0xe7 0x05 0x77 0x05 0x07 0x05 0x96 0x04 0x26 0x04
			0xb6 0x03 0x45 0x03 0xd5 0x02 0x65 0x02 0xf4 0x01 0x84 0x01
			0x14 0x01 0xa3 0x00 0x33 0x00 0xd9 0x0f 0xfe 0x29 0xdc 0x29
			0x8a 0x29 0x4d 0x29 0x28 0x1f 0x23 0x10 0x21 0x21 0x14 0x21
			0xf7 0xf7 0xe6 0xf7 0xd3 0xde 0xca 0xd4 0xd3 0xd4 0x40 0x80
			0x26 0x33 0x26 0x40 0x26 0x5c 0x26 0x5c 0x26 0x5c 0xff 0xff
			0x02 0x05 0x14 0x0b 0x03 0x12 0x06 0x1c 0x0c 0x1c 0x10 0x1c
			0x1f 0x1f 0x40 0x40 0x40 0x3f 0x3e 0x3f 0x3f 0x40 0x40 0x3f
			0x40 0x41 0x43 0x46 0x48 0x4b 0x54 0x60 0x71 0x8b 0xb9 0x05
		>;
		samsung,cell-character1 = /bits/ 8 <
			0xcd 0xb8 0x0b 0x00 0x00 0xcd 0xa0 0x0a 0x00 0x00
			0xcd 0x7f 0x0a 0x00 0x00
		>;

		regulators {
			buck1_reg: BUCK1 {
				regulator-name = "BUCK1";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-ramp-delay = <12000>;
			};

			buck2_reg: BUCK2 {
				regulator-name = "BUCK2";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <2800000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-ramp-delay = <12000>;
			};

			buck3_reg: BUCK3 {
				regulator-name = "BUCK3";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <2800000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-ramp-delay = <12000>;
			};

			ldo1_reg: LDO1 {
				regulator-name = "vdd_ldo1";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
				regulator-boot-on;
				regulator-ramp-delay = <12000>;
			};

			ldo2_reg: LDO2 {
				regulator-name = "vdd_ldo2";
				regulator-min-microvolt = <1500000>;
				regulator-max-microvolt = <2000000>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <12000>;
			};

			ldo3_reg: LDO3 {
				regulator-name = "vdd_ldo3";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1500000>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <12000>;
			};

			ldo4_reg: LDO4 {
				regulator-name = "vqmmc";
				regulator-min-microvolt = <1700000>;
				regulator-max-microvolt = <3350000>;
				regulator-ramp-delay = <12000>;
			};

			ldo5_reg: LDO5 {
				regulator-name = "vdd_ldo5";
				regulator-min-microvolt = <1700000>;
				regulator-max-microvolt = <3350000>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <12000>;
			};

			ldo6_reg: LDO6 {
				regulator-name = "vdd_ldo6";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1300000>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <12000>;
			};

			ldo7_reg: LDO7 {
				regulator-name = "vdd_ldo7";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1300000>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <12000>;
			};

			ldo8_reg: LDO8 {
				regulator-name = "vdd_ldo8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3375000>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <12000>;
			};

			ldo13_reg: LDO13 {
				regulator-name = "vdd_ldo13";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <2000000>;
				regulator-ramp-delay = <12000>;
				regulator-always-on;
				regulator-boot-on;
			};

			ldo14_reg: LDO14 {
				regulator-name = "vemmc";
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3300000>;
				regulator-ramp-delay = <12000>;
			};

			ldo15_reg: LDO15 {
				regulator-name = "vqemmc";
				regulator-min-microvolt = <1700000>;
				regulator-max-microvolt = <1950000>;
				regulator-ramp-delay = <12000>;
			};

			ldo16_reg: LDO16 {
				regulator-name = "VDD_MOTOR_3P3";
				regulator-min-microvolt = <3100000>;
				regulator-max-microvolt = <3100000>;
				regulator-ramp-delay = <12000>;
			};

			ldo17_reg: LDO17 {
				regulator-name = "VDD18_CAM_SENSOR_IO";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-ramp-delay = <12000>;
			};

			ldo18_reg: LDO18 {
				regulator-name = "VDD28_CAM_AF";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
				regulator-ramp-delay = <12000>;
			};

			ldo19_reg: LDO19 {
				regulator-name = "vtouch_2.2v";
				regulator-min-microvolt = <2200000>;
				regulator-max-microvolt = <2200000>;
				regulator-boot-on;
			};

			ldo20_reg: LDO20 {
				regulator-name = "LCD_1P8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
			};

			ldo21_reg: LDO21 {
				regulator-name = "vdd_ldo21";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3375000>;
				regulator-ramp-delay = <12000>;
			};

			ldo22_reg: LDO22 {
				regulator-name = "vdd_ldo22";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3375000>;
				regulator-always-on;
				regulator-ramp-delay = <12000>;
			};

			ldo23_reg: LDO23 {
				regulator-name = "VDD23_CAM_CORE_1P2";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				regulator-ramp-delay = <12000>;
			};

			ldo24_reg: LDO24 {
				regulator-name = "AVDD24_CAM_2P8";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
				regulator-ramp-delay = <12000>;
			};
		};
	};
};

&i2c_muic {
	status = "okay";

	muic: muic@14 {
		compatible = "siliconmitus,sm5504-muic";
		reg = <0x14>;
		interrupt-parent = <&gpa1>;
		interrupts = <1 IRQ_TYPE_EDGE_FALLING>;
		pinctrl-names = "default";
		pinctrl-0 = <&muic_irq>;
	};
};

&i2c_tsp {
	status = "okay";

	touchscreen@48 {
		compatible = "melfas,mip4_ts";
		reg = <0x48>;
		interrupt-parent = <&gpc3>;
		interrupts = <2 IRQ_TYPE_LEVEL_LOW>;
		/* switches the 3.3 V supply of the controller */
		ce-gpios = <&gpc2 3 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&tsp_irq>;
	};
};

&decon {
	status = "okay";
};

&dsi {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	samsung,burst-clock-frequency = <490000000>;
	samsung,pll-clock-frequency = <26000000>;
	samsung,esc-clock-frequency = <16000000>;

	panel@0 {
		compatible = "samsung,ea8061s";
		reg = <0>;

		/* S-BOOT leaves the panel on with the video stream running */
		samsung,keep-bootloader-state;

		vddio-supply = <&ldo20_reg>;
		enable-gpios = <&gpd1 0 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpd2 0 GPIO_ACTIVE_HIGH>;
	};
};

/*
 * Shannon modem (SS305AP) over shared memory, for the downstream modem_v1
 * interface (drivers/misc/modem_v1): the carveout is split into the CP boot
 * region (0x5800000) and the IPC region (0x400000). mif_pdata is the
 * downstream modem-ss305ap-pdata.dtsi unchanged but for the interrupts.
 */
/ {
	shmem {
		compatible = "samsung,exynos-shm_ipc";
		memory-region = <&modem_rmem>;
		shmem,ipc_offset = <0x5800000>;
		shmem,ipc_size = <0x400000>;
	};

	mif_pdata {
		compatible = "sec_modem,modem_pdata";
		status = "okay";
		/* start = offset of the CP main image in the boot region (from the J4 board dts) */
		reg = <0x0 0x10000 0x0>;

		pinctrl-names = "default";
		pinctrl-0 = <&cp_gpio_j4lte>;

		interrupts = <GIC_SPI 18 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 479 IRQ_TYPE_LEVEL_HIGH>;

		/* common pdata */
		mif,name = "ss305ap";
		mif,modem_net = <0>;		/* UMTS_NETWORK */
		mif,modem_type = <10>;		/* SEC_SS310AP */
		mif,use_handover = <0>;		/* not used */
		mif,ipc_version = <50>;		/* SIPC 5.0 */
		mif,link_types = <0x200>;	/* LINKDEV_SHMEM */
		mif,link_name = "shmem";
		mif,link_attrs = <0x7C8>;	/* XMIT_BTDLR(0x400) | DUMP_ALIGNED (0x200) | BOOT_ALIGNED (0x100) | MEM_DUMP (0x80) | MEM_BOOT (0x40) | DPRAM_MAGIC (0x08) */
		mif,num_iodevs = <19>;

		/* mbox pdata */
		mbx_ap2cp_msg = <0>;
		mbx_cp2ap_msg = <1>;
		mbx_ap2cp_united_status = <2>;
		mbx_cp2ap_united_status = <3>;

		mif,int_ap2cp_msg = <0>;
		mif,int_ap2cp_status = <2>;
		mif,int_ap2cp_active = <3>;

		mif,irq_cp2ap_msg = <0>;
		mif,irq_cp2ap_status = <2>;
		mif,irq_cp2ap_active = <3>;
		mif,irq_cp2ap_wake_lock = <8>;

		/* mbox pdata for performance request */
		mbx_cp2ap_dvfsreq = <4>;
		mbx_cp2ap_dvfsreq_mif = <6>;

		mif,irq_cp2ap_perf_req_mif = <6>; /* CP2AP_DVFSREQ_MIF */

		/* CP voltage information */
		mbx_ap2cp_cp_voltage_700 = <5>;
		mbx_ap2cp_cp_voltage_830 = <7>;

		/* mbox pdata for sbi(status bit info) */
		sbi_evs_mode_mask = <0x1>;
		sbi_evs_mode_pos = <7>;
		sbi_lte_active_mask = <0x1>;
		sbi_lte_active_pos = <5>;
		sbi_cp_status_mask = <0xf>;
		sbi_cp_status_pos = <1>;
		sbi_pda_active_mask = <0x1>;
		sbi_pda_active_pos = <5>;
		sbi_ap_status_mask = <0xf>;
		sbi_ap_status_pos = <1>;

		sbi_ds_det_mask = <0x3>;
		sbi_ds_det_pos = <14>;
		sbi_sys_rev_mask = <0xff>;
		sbi_sys_rev_pos = <6>;
		
		sbi_cp_cpu_freq_asv_mask = <0x7>;
		sbi_cp_cpu_freq_asv_pos = <19>;

		iodevs {
			io_device_0 {
				iod,name = "umts_ipc0";
				iod,id = <235>;
				iod,format = <0>;		/* IPC_FMT */
				iod,io_type = <0>;		/* IODEV_MISC */
				iod,links = <0x200>;		/* LINKDEV_SHMEM */
